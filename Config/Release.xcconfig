// Optional include — real secrets (Google client ID, Maps API key) live in Secrets.xcconfig,
// which is gitignored. `?` makes this a no-op if the file doesn't exist yet.
#include? "Secrets.xcconfig"

// Release build configuration — mirrors fuel-android's release BuildConfig.API_BASE_URL.
// NOTE: xcconfig treats `//` as a comment start, so `$()` (empty macro expansion) is inserted to
// break up the sequence without changing the substituted value — a standard xcconfig workaround.
API_BASE_URL = https:/$()/api.fueltracker.uk

// Google Sign-In web/server client ID comes from the Secrets.xcconfig include above when present.

GOOGLE_MAPS_API_KEY = $(GOOGLE_MAPS_API_KEY_RELEASE)

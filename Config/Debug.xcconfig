// Optional include — real secrets (Google client ID, Maps API key) live in Secrets.xcconfig,
// which is gitignored. `?` makes this a no-op if the file doesn't exist yet.
#include? "Secrets.xcconfig"

// Debug build configuration.
// Points at the production backend rather than localhost — no local fuel-api dev server is
// assumed to be running. Switch back to a local URL here if you spin one up.
// NOTE: xcconfig treats `//` as a comment start, so `$()` (empty macro expansion) is inserted to
// break up the sequence without changing the substituted value — a standard xcconfig workaround.
API_BASE_URL = https:/$()/api.fueltracker.uk

// Google Sign-In web/server client ID and Maps API key come from the Secrets.xcconfig include
// above when present. The "Continue with Google" button shows a friendly "not configured yet"
// message rather than crashing when GOOGLE_CLIENT_ID is empty.

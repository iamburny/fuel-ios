// Copy this file to Secrets.xcconfig (gitignored) and fill in real values.
// Referenced from Debug.xcconfig / Release.xcconfig (via #include?).
GOOGLE_MAPS_API_KEY_DEBUG = your-debug-ios-maps-api-key-here
GOOGLE_MAPS_API_KEY_RELEASE = your-release-ios-maps-api-key-here
// Two separate OAuth clients are required: an iOS-type client for the native sign-in redirect,
// and a Web-type client passed as serverClientID so the ID token's `aud` matches what fuel-api
// verifies against. Google rejects the custom-URL-scheme redirect for a Web-type client.
GOOGLE_IOS_CLIENT_ID = your-google-oauth-ios-client-id.apps.googleusercontent.com
// Reverse the segments of GOOGLE_IOS_CLIENT_ID before ".apps.googleusercontent.com", e.g.
// "1234-abcd.apps.googleusercontent.com" -> "com.googleusercontent.apps.1234-abcd"
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.your-ios-client-id
GOOGLE_SERVER_CLIENT_ID = your-google-oauth-web-client-id.apps.googleusercontent.com
// Unleash Frontend API client key (not the URL — that's hardcoded in Debug/Release.xcconfig).
UNLEASH_CLIENT_KEY = your-unleash-frontend-api-client-key

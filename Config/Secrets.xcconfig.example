// Copy this file to Secrets.xcconfig (gitignored) and fill in real values.
// Referenced from Debug.xcconfig / Release.xcconfig (via #include?).
GOOGLE_MAPS_API_KEY_DEBUG = your-debug-ios-maps-api-key-here
GOOGLE_MAPS_API_KEY_RELEASE = your-release-ios-maps-api-key-here
GOOGLE_CLIENT_ID = your-google-oauth-web-client-id.apps.googleusercontent.com
// Reverse the segments of GOOGLE_CLIENT_ID before ".apps.googleusercontent.com", e.g.
// "1234-abcd.apps.googleusercontent.com" -> "com.googleusercontent.apps.1234-abcd"
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.your-client-id
